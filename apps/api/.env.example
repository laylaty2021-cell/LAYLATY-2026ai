# Copy to .env for local development (.env is gitignored).

PORT=3000
NODE_ENV=development

# docker-compose (see ../../infrastructure/docker-compose.yml) exposes
# Postgres on localhost:5432 and Redis on localhost:6379 with these
# credentials by default.
DATABASE_URL="postgresql://laylaty:laylaty@localhost:5432/laylaty_dev"
REDIS_URL="redis://localhost:6379"

# Generate real secrets for anything beyond local dev:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_REFRESH_TTL_DAYS=30
