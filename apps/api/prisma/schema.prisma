// Laylaty Platform — Prisma schema
//
// This is the ORM-level mirror of ../../docs/database/schema.sql. It is
// generated by hand to match that file field-for-field; if the two ever
// diverge, docs/database/schema.sql is the source of truth (see blueprint
// §5 "Prisma with a Repository layer on top" — no module may import
// PrismaClient directly, only its own repository).
//
// Postgres-specific pieces Prisma cannot express are applied as a raw-SQL
// follow-up migration instead of being modeled here:
//   - CITEXT columns (email, slug, phone) — Prisma has no citext type;
//     these are modeled as `String @db.Citext` via the citext extension.
//   - The booking anti-double-booking EXCLUDE USING gist constraint.
//   - CHECK constraints (e.g. price >= 0, starts_at < ends_at).
// See prisma/migrations/<ts>_manual_constraints/migration.sql once
// `prisma migrate dev` has generated the base migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, pg_trgm, btree_gist]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  active
  suspended
  pending_verification
  deleted
}

enum UserType {
  customer
  merchant
  admin
}

enum OrgStatus {
  pending
  active
  suspended
  rejected
}

enum StoreStatus {
  draft
  pending_review
  active
  suspended
  closed
}

enum BusinessType {
  wedding_hall
  florist
  photographer
  restaurant
  beauty
  transportation
  catering
  other
}

enum OrgMemberRole {
  owner
  manager
  staff
  accountant
}

enum SellableItemType {
  product
  service
  booking
  package
}

enum CatalogItemStatus {
  draft
  active
  archived
  out_of_stock
}

enum BookingStatus {
  held
  confirmed
  cancelled
  completed
  expired
}

enum EventStatus {
  planning
  confirmed
  completed
  cancelled
}

enum EventTaskStatus {
  pending
  in_progress
  done
  skipped
}

enum BudgetItemStatus {
  planned
  reserved
  paid
}

enum CartStatus {
  active
  converted
  abandoned
}

enum OrderStatus {
  pending_payment
  paid
  processing
  ready
  shipped
  delivered
  completed
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  authorized
  succeeded
  failed
  refunded
  partially_refunded
}

enum PaymentTargetType {
  order
  booking
}

enum RefundStatus {
  pending
  succeeded
  failed
}

enum ShipmentStatus {
  pending
  label_created
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed
  cancelled
}

enum NotificationChannel {
  push
  sms
  email
  in_app
}

enum NotificationStatus {
  queued
  sent
  failed
  read
}

enum InventoryMovementType {
  reserve
  release
  confirm
  adjust
  restock
}

// ============================================================================
// 1. IDENTITY
// ============================================================================

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String?    @unique @db.Citext
  phone        String?    @unique @db.VarChar(20)
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name") @db.VarChar(150)
  avatarUrl    String?    @map("avatar_url")
  userType     UserType   @default(customer) @map("user_type")
  status       UserStatus @default(pending_verification)
  locale       String     @default("ar") @db.VarChar(10)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens       RefreshToken[]
  addresses           Address[]
  organizationsOwned  Organization[]       @relation("OrganizationOwner")
  organizationMembers OrganizationMember[]
  adminUserRoles      AdminUserRole[]
  events              Event[]
  bookings            Booking[]
  carts               Cart[]
  orders              Order[]
  reviews             Review[]
  notifications       Notification[]
  auditLogsActed      AuditLog[]
  refundsRequested    Refund[]

  @@index([userType])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String    @db.VarChar(150)
  codeHash   String    @map("code_hash")
  purpose    String    @db.VarChar(30)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifier])
  @@map("otp_codes")
}

model AdminRole {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key  String @unique @db.VarChar(50)
  name String @db.VarChar(100)

  rolePermissions AdminRolePermission[]
  userRoles       AdminUserRole[]

  @@map("admin_roles")
}

model AdminPermission {
  id  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key String @unique @db.VarChar(100)

  rolePermissions AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("admin_user_roles")
}

model Address {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String?  @db.VarChar(50)
  city        String   @db.VarChar(100)
  district    String?  @db.VarChar(100)
  addressLine String   @map("address_line")
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================================================
// 2. ORGANIZATIONS & STORES
// ============================================================================

model Organization {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId            String    @map("owner_user_id") @db.Uuid
  name                   String    @db.VarChar(200)
  commercialRegistration String?   @map("commercial_registration") @db.VarChar(50)
  taxNumber              String?   @map("tax_number") @db.VarChar(50)
  status                 OrgStatus @default(pending)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  owner   User                 @relation("OrganizationOwner", fields: [ownerUserId], references: [id])
  members OrganizationMember[]
  stores  Store[]

  @@index([ownerUserId])
  @@index([status])
  @@map("organizations")
}

model OrganizationMember {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  role           OrgMemberRole @default(staff)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Store {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(200)
  slug           String       @unique @db.Citext
  businessType   BusinessType @map("business_type")
  description    String?
  logoUrl        String?      @map("logo_url")
  coverUrl       String?      @map("cover_url")
  city           String?      @db.VarChar(100)
  status         StoreStatus  @default(draft)
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modules            StoreModule[]
  products           Product[]
  services           Service[]
  packages           Package[]
  bookingResources   BookingResource[]
  inventoryLocations InventoryLocation[]
  carts              Cart[]
  orders             Order[]
  reviews            Review[]

  @@index([organizationId])
  @@index([status])
  @@index([businessType])
  @@index([city])
  @@map("stores")
}

model StoreModule {
  storeId   String  @map("store_id") @db.Uuid
  moduleKey String  @map("module_key") @db.VarChar(50)
  enabled   Boolean @default(true)
  config    Json    @default("{}")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, moduleKey])
  @@map("store_modules")
}

// ============================================================================
// 3. CATALOG
// ============================================================================

model Category {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?           @map("parent_id") @db.Uuid
  name      String            @db.VarChar(150)
  slug      String            @unique @db.Citext
  appliesTo SellableItemType? @map("applies_to")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  services Service[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String            @map("store_id") @db.Uuid
  categoryId       String?           @map("category_id") @db.Uuid
  name             String            @db.VarChar(200)
  slug             String            @db.Citext
  description      String?
  basePrice        Decimal           @map("base_price") @db.Decimal(12, 2)
  currency         String            @default("SAR") @db.VarChar(3)
  status           CatalogItemStatus @default(draft)
  requiresShipping Boolean           @default(true) @map("requires_shipping")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String?  @unique @db.VarChar(100)
  attributes Json     @default("{}")
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryStock InventoryStock[]

  @@index([productId])
  @@map("product_variants")
}

model Service {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String            @map("store_id") @db.Uuid
  categoryId      String?           @map("category_id") @db.Uuid
  name            String            @db.VarChar(200)
  slug            String            @db.Citext
  description     String?
  price           Decimal           @db.Decimal(12, 2)
  currency        String            @default("SAR") @db.VarChar(3)
  durationMinutes Int?              @map("duration_minutes")
  status          CatalogItemStatus @default(draft)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([status])
  @@map("services")
}

model Package {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String            @map("store_id") @db.Uuid
  name        String            @db.VarChar(200)
  slug        String            @db.Citext
  description String?
  price       Decimal           @db.Decimal(12, 2)
  currency    String            @default("SAR") @db.VarChar(3)
  status      CatalogItemStatus @default(draft)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items PackageItem[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("packages")
}

// item_id is a polymorphic reference (product/service/booking_resource id) —
// Prisma cannot enforce a polymorphic FK, so this is a plain UUID column,
// exactly as in schema.sql. Integrity is enforced in the repository layer.
model PackageItem {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId String           @map("package_id") @db.Uuid
  itemType  SellableItemType @map("item_type")
  itemId    String           @map("item_id") @db.Uuid
  quantity  Int              @default(1)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([itemType, itemId])
  @@map("package_items")
}

// ============================================================================
// 4. INVENTORY
// ============================================================================

model InventoryLocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String   @db.VarChar(150)
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryStock InventoryStock[]

  @@index([storeId])
  @@map("inventory_locations")
}

model InventoryStock {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location  InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([variantId, locationId])
  @@index([variantId])
  @@map("inventory_stock")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockId       String                @map("stock_id") @db.Uuid
  movementType  InventoryMovementType @map("movement_type")
  quantity      Int
  referenceType String?               @map("reference_type") @db.VarChar(30)
  referenceId   String?               @map("reference_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz

  stock InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ============================================================================
// 5. BOOKING ENGINE
// ============================================================================

model BookingResource {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String            @map("store_id") @db.Uuid
  name        String            @db.VarChar(200)
  description String?
  capacity    Int?
  basePrice   Decimal           @map("base_price") @db.Decimal(12, 2)
  currency    String            @default("SAR") @db.VarChar(3)
  status      CatalogItemStatus @default(active)
  settings    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  store             Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  availabilityRules ResourceAvailabilityRule[]
  blackoutDates     ResourceBlackoutDate[]
  bookings          Booking[]

  @@index([storeId])
  @@map("booking_resources")
}

model ResourceAvailabilityRule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt
  startTime  DateTime @map("start_time") @db.Time
  endTime    DateTime @map("end_time") @db.Time

  resource BookingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_availability_rules")
}

model ResourceBlackoutDate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz
  endsAt     DateTime @map("ends_at") @db.Timestamptz
  reason     String?  @db.VarChar(200)

  resource BookingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_blackout_dates")
}

// The anti-double-booking `EXCLUDE USING gist` constraint (see
// docs/database/schema.sql) is applied via a manual follow-up migration —
// Prisma's schema language has no way to express it.
model Booking {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId    String        @map("resource_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  eventId       String?       @map("event_id") @db.Uuid
  orderId       String?       @unique @map("order_id") @db.Uuid
  startsAt      DateTime      @map("starts_at") @db.Timestamptz
  endsAt        DateTime      @map("ends_at") @db.Timestamptz
  status        BookingStatus @default(held)
  holdExpiresAt DateTime?     @map("hold_expires_at") @db.Timestamptz
  totalPrice    Decimal       @map("total_price") @db.Decimal(12, 2)
  currency      String        @default("SAR") @db.VarChar(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  resource   BookingResource @relation(fields: [resourceId], references: [id])
  customer   User            @relation(fields: [customerId], references: [id])
  event      Event?          @relation(fields: [eventId], references: [id])
  order      Order?          @relation(fields: [orderId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([resourceId])
  @@index([customerId])
  @@index([eventId])
  @@index([status])
  @@index([holdExpiresAt])
  @@map("bookings")
}

// ============================================================================
// 6. EVENTS
// ============================================================================

model Event {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  name        String      @db.VarChar(200)
  eventType   String      @map("event_type") @db.VarChar(50)
  eventDate   DateTime    @map("event_date") @db.Date
  city        String?     @db.VarChar(100)
  budgetTotal Decimal?    @map("budget_total") @db.Decimal(12, 2)
  currency    String      @default("SAR") @db.VarChar(3)
  status      EventStatus @default(planning)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  customer    User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tasks       EventTask[]
  budgetItems EventBudgetItem[]
  bookings    Booking[]
  orders      Order[]
  carts       Cart[]

  @@index([customerId])
  @@index([eventDate])
  @@index([status])
  @@map("events")
}

model EventTaskTemplate {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType       String  @map("event_type") @db.VarChar(50)
  title           String  @db.VarChar(200)
  daysBeforeEvent Int     @map("days_before_event")
  category        String? @db.VarChar(50)

  @@map("event_task_templates")
}

model EventTask {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String          @map("event_id") @db.Uuid
  title     String          @db.VarChar(200)
  category  String?         @db.VarChar(50)
  dueDate   DateTime?       @map("due_date") @db.Date
  status    EventTaskStatus @default(pending)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@map("event_tasks")
}

model EventBudgetItem {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String           @map("event_id") @db.Uuid
  category      String           @db.VarChar(50)
  plannedAmount Decimal          @default(0) @map("planned_amount") @db.Decimal(12, 2)
  actualAmount  Decimal          @default(0) @map("actual_amount") @db.Decimal(12, 2)
  status        BudgetItemStatus @default(planned)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_budget_items")
}

// ============================================================================
// 7. COMMERCE
// ============================================================================

model Cart {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String     @map("customer_id") @db.Uuid
  storeId    String     @map("store_id") @db.Uuid
  eventId    String?    @map("event_id") @db.Uuid
  status     CartStatus @default(active)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  event    Event?     @relation(fields: [eventId], references: [id])
  items    CartItem[]

  @@index([customerId])
  @@index([storeId, status])
  @@map("carts")
}

model CartItem {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String           @map("cart_id") @db.Uuid
  itemType  SellableItemType @map("item_type")
  itemId    String           @map("item_id") @db.Uuid
  variantId String?          @map("variant_id") @db.Uuid
  bookingId String?          @map("booking_id") @db.Uuid
  quantity  Int              @default(1)
  unitPrice Decimal          @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber       String      @unique @map("order_number") @db.VarChar(30)
  customerId        String      @map("customer_id") @db.Uuid
  storeId           String      @map("store_id") @db.Uuid
  eventId           String?     @map("event_id") @db.Uuid
  status            OrderStatus @default(pending_payment)
  subtotal          Decimal     @db.Decimal(12, 2)
  taxAmount         Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  shippingFee       Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount       Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency          String      @default("SAR") @db.VarChar(3)
  shippingAddressId String?     @map("shipping_address_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  customer        User        @relation(fields: [customerId], references: [id])
  store           Store       @relation(fields: [storeId], references: [id])
  event           Event?      @relation(fields: [eventId], references: [id])
  shippingAddress Address?    @relation(fields: [shippingAddressId], references: [id])
  items           OrderItem[]
  booking         Booking?
  reviews         Review[]
  shipment        Shipment?

  @@index([customerId])
  @@index([storeId, status, createdAt])
  @@index([eventId])
  @@map("orders")
}

model OrderItem {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String           @map("order_id") @db.Uuid
  itemType     SellableItemType @map("item_type")
  itemId       String           @map("item_id") @db.Uuid
  variantId    String?          @map("variant_id") @db.Uuid
  bookingId    String?          @map("booking_id") @db.Uuid
  nameSnapshot String           @map("name_snapshot") @db.VarChar(200)
  quantity     Int              @default(1)
  unitPrice    Decimal          @map("unit_price") @db.Decimal(12, 2)
  totalPrice   Decimal          @map("total_price") @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([orderId])
  @@index([itemType, itemId])
  @@map("order_items")
}

// ============================================================================
// 8. PAYMENTS
// ============================================================================

model Payment {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType        PaymentTargetType @map("target_type")
  targetId          String            @map("target_id") @db.Uuid
  provider          String            @db.VarChar(50)
  providerPaymentId String?           @map("provider_payment_id") @db.VarChar(150)
  idempotencyKey    String            @unique @map("idempotency_key") @db.VarChar(150)
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("SAR") @db.VarChar(3)
  status            PaymentStatus     @default(pending)
  rawResponse       Json?             @map("raw_response")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  refunds Refund[]

  @@index([targetType, targetId])
  @@index([status])
  @@map("payments")
}

// UNIQUE (provider, event_id) is the idempotency guarantee for webhook
// ingestion — see docs/database/erd.md §5.
model PaymentWebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @db.VarChar(50)
  eventId     String    @map("event_id") @db.VarChar(150)
  eventType   String    @map("event_type") @db.VarChar(100)
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model Refund {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String       @map("payment_id") @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  reason      String?
  status      RefundStatus @default(pending)
  requestedBy String?      @map("requested_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  payment   Payment @relation(fields: [paymentId], references: [id])
  requester User?   @relation(fields: [requestedBy], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ============================================================================
// 9. LOGISTICS / SHIPPING
// ============================================================================

model Shipment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String         @unique @map("order_id") @db.Uuid
  provider       String         @db.VarChar(50)
  trackingNumber String?        @map("tracking_number") @db.VarChar(150)
  status         ShipmentStatus @default(pending)
  labelUrl       String?        @map("label_url")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  @@map("shipments")
}

model ShipmentEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId  String         @map("shipment_id") @db.Uuid
  status      ShipmentStatus
  description String?
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
}

// ============================================================================
// 10. NOTIFICATIONS
// ============================================================================

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  eventKey  String              @map("event_key") @db.VarChar(100)
  payload   Json                @default("{}")
  status    NotificationStatus  @default(queued)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz
  readAt    DateTime?           @map("read_at") @db.Timestamptz
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

// ============================================================================
// 11. REVIEWS
// ============================================================================

model Review {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  storeId    String            @map("store_id") @db.Uuid
  itemType   SellableItemType? @map("item_type")
  itemId     String?           @map("item_id") @db.Uuid
  orderId    String?           @map("order_id") @db.Uuid
  rating     Int               @db.SmallInt
  comment    String?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id])

  @@index([storeId])
  @@index([itemType, itemId])
  @@map("reviews")
}

// ============================================================================
// 12. AUDIT LOG
// ============================================================================

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
